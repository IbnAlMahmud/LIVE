{
  "entities": {
    "Settings": {
      "title": "Settings",
      "description": "Global application settings, such as Meta Pixel configuration.",
      "type": "object",
      "properties": {
        "metaPixelId": {
          "type": "string",
          "description": "The Meta Pixel ID for tracking."
        },
        "updatedAt": {
          "type": "string",
          "description": "Last updated timestamp."
        }
      }
    },
    "Project": {
      "title": "Project",
      "description": "A portfolio project.",
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "maxLength": 100
        },
        "description": {
          "type": "string",
          "maxLength": 1000
        },
        "thumbnail": {
          "type": "string",
          "maxLength": 500
        },
        "category": {
          "type": "string",
          "maxLength": 50
        },
        "industry": {
          "type": "string",
          "maxLength": 50
        },
        "createdAt": {
          "type": "string"
        }
      },
      "required": ["title", "thumbnail", "category", "createdAt"]
    },
    "Demo": {
      "title": "Demo",
      "description": "A demo website showcase with rich preview assets and case studies.",
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "maxLength": 100
        },
        "title": {
          "type": "string",
          "maxLength": 100
        },
        "slug": {
          "type": "string",
          "maxLength": 100
        },
        "category": {
          "type": "string",
          "maxLength": 50
        },
        "industry": {
          "type": "string",
          "maxLength": 100
        },
        "type": {
          "type": "string",
          "maxLength": 100
        },
        "shortDescription": {
          "type": "string",
          "maxLength": 500
        },
        "description": {
          "type": "string",
          "maxLength": 3000
        },
        "thumbnail": {
          "type": "string",
          "maxLength": 1000
        },
        "heroImage": {
          "type": "string",
          "maxLength": 1000
        },
        "desktopPreview": {
          "type": "string",
          "maxLength": 1000
        },
        "tabletPreview": {
          "type": "string",
          "maxLength": 1000
        },
        "mobilePreview": {
          "type": "string",
          "maxLength": 1000
        },
        "previewVideo": {
          "type": "string",
          "maxLength": 1000
        },
        "liveUrl": {
          "type": "string",
          "maxLength": 1000
        },
        "caseStudyUrl": {
          "type": "string",
          "maxLength": 1000
        },
        "sortOrder": {
          "type": "number"
        },
        "featured": {
          "type": "boolean"
        },
        "published": {
          "type": "boolean"
        },
        "createdAt": {
          "type": "string"
        },
        "updatedAt": {
          "type": "string"
        }
      },
      "required": ["title", "thumbnail", "category", "createdAt"]
    }
  },
  "firestore": {
    "settings/{settingId}": {
      "schema": "Settings",
      "description": "Stores global settings."
    },
    "projects/{projectId}": {
      "schema": "Project",
      "description": "Stores portfolio projects."
    },
    "demos/{demoId}": {
      "schema": "Demo",
      "description": "Stores demo websites."
    }
  }
}
